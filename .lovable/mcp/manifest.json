{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://elirsesfjppnmahbmrgc.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "surprise-sentiments",
      "version": "0.1.0",
      "title": "Surprise Sentiments"
    },
    "tools": [
      {
        "name": "list_wishes",
        "title": "List birthday surprises",
        "description": "List the birthday surprises created by the signed-in user, newest first, with their shareable links.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "description": "How many surprises to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_wish",
        "title": "Get a birthday surprise",
        "description": "Fetch one of the signed-in user's birthday surprises by id, including its letter, media and share link.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The surprise id."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "create_wish",
        "title": "Create a birthday surprise",
        "description": "Create a birthday surprise page for the signed-in user with a written letter, an optional unlock date/time and a viewing window. Photos and videos are added in the app.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "recipient_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Who the surprise is for."
            },
            "sender_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Who it is from."
            },
            "letter": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "description": "The birthday letter text."
            },
            "birthday_date": {
              "description": "Unlock date as YYYY-MM-DD.",
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "birthday_time": {
              "description": "Unlock time as HH:MM (24h).",
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{2}:\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "view_duration_hours": {
              "default": 24,
              "description": "How many hours the surprise stays viewable after unlocking.",
              "type": "integer",
              "minimum": 1,
              "maximum": 168
            }
          },
          "required": [
            "recipient_name",
            "sender_name",
            "letter"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "update_wish_letter",
        "title": "Rewrite a surprise letter",
        "description": "Replace the letter text of one of the signed-in user's birthday surprises.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The surprise id."
            },
            "letter": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "description": "The new letter text."
            }
          },
          "required": [
            "id",
            "letter"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "delete_wish",
        "title": "Delete a birthday surprise",
        "description": "Permanently delete one of the signed-in user's birthday surprises and disable its share link.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The surprise id to delete."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
